[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath12k/IPQ5332/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x1000 0x20000
		;;
	gl.inet,gl-be9300)
		# ART's own length header at +0x1008 says the 2.4 GHz cal
		# block is 0xf800 bytes (stock cnss downloads exactly that).
		# 0x20000 over-reads into blank ART space; kept because this
		# exact length is what was validated on hardware and ath12k
		# ignores the tail. Do not extend further: the per-device
		# cert/key region starts at +0x80000.
		caldata_extract_mmc "0:ART" 0x1000 0x20000
		;;
	esac
	;;
"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
	case "$board" in
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x58800 0x18800
		;;
	gl.inet,gl-be9300)
		# dualmac QCN9274: cal block is 0x27800 long (verified
		# against the ART partition dump from a live unit)
		caldata_extract_mmc "0:ART" 0x58800 0x27800
		;;
	esac
	;;
*)
	exit 1
	;;
esac
